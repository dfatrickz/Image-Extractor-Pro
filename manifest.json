{
  "manifest_version": 3,
  "name": "FastGrab Image Downloader",
  "version": "2.0.0",
  "description": "Extract, filter, and download high-resolution images. Features Advanced Settings for lazy-load bypassing, Fast Grab hover downloads, and global floating UI.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "FastGrab Image Downloader"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fastgrab-image-downloader@github.dfatrickz",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
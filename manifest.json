{
  "manifest_version": 3,
  "name": "Image Extractor Pro",
  "version": "2.0.0",
  "description": "Extract, filter, and download high-resolution images. Features optional Advanced Settings for lazy-load bypassing, Fast Grab hover downloads, and global floating UI.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
  	"<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Image Extractor Pro"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
	"48": "icon-48.png",
	"128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "image-extractor-pro@github.demigui",
      "strict_min_version": "121.0"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Image Extractor Pro",
  "version": "2.0.0",
  "description": "Select a page area, preview matching images, and send them to a review gallery for download.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.flickr.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Image Extractor Pro"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "image-extractor-pro@codex.local",
      "strict_min_version": "121.0"
    }
  }
}
